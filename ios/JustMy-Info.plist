<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Only keys build settings can't express. Everything else is generated (GENERATE_INFOPLIST_FILE).
	     NSAllowsLocalNetworking lets a dev pairing reach http://localhost or a .local host; the
	     production server is always https, and PairingPayload refuses plain http anywhere else. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
